{
  "name": "incident-management",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "@sap/cds-mtxs": "^4.1.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10.1.1",
    "cds-plugin-ui5": "^0.17.4"
  },
  "scripts": {
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test --test-timeout=30000 test/test.js",
    "start": "cds-serve",
    "watch-incidentscw36": "cds watch --open ns.incidentscw36/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "support"
              ],
              "tenant": "t1"
            },
            "bob": {
              "roles": [
                "admin"
              ]
            },
            "erin": {
              "roles": [
                "support"
              ],
              "tenant": "t2"
            }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "html5-repo": true,
      "workzone": true,
      "[with-mtx]": {
        "multitenancy": true
      },
      "destinations": true
    },
    "profile": "with-mtx-sidecar"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/incidentscw36"
  ]
}
